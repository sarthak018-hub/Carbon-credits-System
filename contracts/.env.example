# Polygon Amoy RPC URL (Required)
AMOY_RPC_URL=https://rpc-amoy.polygon.technology

# Private Key of deployer account (Required for deployment)
# Get from MetaMask: Settings > Security & Privacy > Show Private Key
PRIVATE_KEY=

# Auditor address (Optional, can be set later)
AUDITOR_ADDRESS=

# Polygonscan API Key (Optional, for contract verification)
POLYGONSCAN_API_KEY=
